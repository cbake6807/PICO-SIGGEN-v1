<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always shows a system splash (the launcher icon) first.
         Same background as ours, so it hands over without a visible cut. -->
    <style name="Theme.GatedPulse" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/vellum</item>
        <item name="android:windowSplashScreenBackground">@color/vellum</item>
    </style>
</resources>
