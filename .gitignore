# Your WiFi credentials. The firmware builds and runs fine without this file --
# it just stays offline. NEVER commit it.
GatedPulsePico/secrets.h

# Build artifacts
build/
*.elf
*.uf2
*.bin

# Python
__pycache__/
*.py[cod]

# OS noise
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp

# Stamped by `make build` with the git revision; rewritten every build
GatedPulsePico/build_info.h

# The sensor board's WiFi credentials, same rule as above
SensorNode/secrets.h

# Android app build output (the APK itself, android/GatedPulse.apk, IS committed:
# phones download it from the repo)
android/build/
